# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env*
# ...but the template carries no secrets and is needed to set the project up.
!.env.example

# Local development artifacts and test output
.nexora/
sample-sales.csv
*.tmp
docid.txt
dsid.txt
stream.txt
req.json
upload-result.json
# Generated reports and rendered pages from manual testing
report*.pdf
report*.xlsx
quote*.pdf
quote*.xlsx
pdfpages/
quotepages/
pdfbranded/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-mode data store
/.nexora

# Test artefacts produced by scripts/ during verification
/report*.pdf
/report*.xlsx
/pdfpages
/pdfbranded
/test-logo.png
/test-signature.png
/stream.txt
/req.json
/rid.txt
/dsid.txt
/upload-result.json

