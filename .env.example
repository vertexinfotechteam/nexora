# =============================================================================
# NEXORA AI — copy this file to `.env.local` and fill it in.
# `.env.local` is gitignored. NEVER commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE  (Project Settings -> API)
# Leave blank to run in LOCAL MODE: data stays in ./.nexora on this machine and
# auth uses a local dev session. Fill these in to switch to real multi-tenant
# Supabase Auth + Postgres + Storage. No code changes needed.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Used for username->email lookup,
# audit logging and usage metering. Bypasses RLS, so it must never reach the client.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI PROVIDERS — set one or more. The orchestrator picks the first configured
# provider and falls back down the list if a call fails.
# -----------------------------------------------------------------------------
# Preferred provider when several are configured: anthropic | gemini | openai | ollama
NEXUS_AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Newer Gemini keys get 404 on the 2.5 line. Verified working: gemini-3.6-flash,
# gemini-3-flash-preview, gemini-3.1-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Local development model. Example: http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# -----------------------------------------------------------------------------
# ENGINE LIMITS — hard ceilings on AI-generated queries.
# -----------------------------------------------------------------------------
NEXUS_SQL_TIMEOUT_MS=15000
NEXUS_SQL_MAX_ROWS=10000
NEXUS_MAX_UPLOAD_BYTES=104857600

# Where local-mode data lives (relative to the project root).
NEXUS_DATA_DIR=.nexora

# -----------------------------------------------------------------------------
# SITE URL — the public origin this deployment is served from.
#
# Used to build the links emailed to users (confirmation, password reset, OAuth
# return). Set this in production. Without it those links would have to be
# built from the request's Origin header, which the caller controls: an
# attacker could submit the forgot-password form with their own origin and the
# recovery link sent to the victim would point at their site.
# -----------------------------------------------------------------------------
NEXUS_SITE_URL=

# -----------------------------------------------------------------------------
# PLATFORM STAFF — who may read messages sent through the public contact form.
#
# Comma-separated emails. This is not a workspace role: signing up makes every
# user the owner of their own workspace, so a role check would expose every
# visitor's name, email and message to every customer. Leave this empty and
# nobody can read them, which is the safe way to fail.
# -----------------------------------------------------------------------------
NEXUS_PLATFORM_ADMIN_EMAILS=
